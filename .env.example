# Public Supabase settings used by the browser and by the server's RLS-scoped client.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional standalone Node API settings (the Next.js app also provides /api routes).
PORT=4001
CHATRA_CLIENT_ORIGIN=http://localhost:3000
